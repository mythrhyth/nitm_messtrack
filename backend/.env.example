# Server Port Configuration
PORT=10000

# Node Environment Mode (development / production)
NODE_ENV=production

# PostgreSQL Connection String (e.g. hosted on Neon)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Secret key for signing JSON Web Tokens (JWT)
JWT_SECRET="generate-a-secure-random-32-byte-string"

# Cross-Origin Resource Sharing Allowed Origins (comma-separated URLs, or * for all)
CORS_ORIGIN="https://your-frontend-domain.vercel.app"
